# ---------------------------------------------------------------
# StudyMCP AI - environment variables (copy to backend/.env)
# ---------------------------------------------------------------

# PostgreSQL connection string (local or Supabase).
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres:password@localhost:5432/studymcp?schema=public

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=5000
NODE_ENV=development

# Comma separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173

# MCP transport: "stdio" (separate process, default) or "inmemory" (same process)
MCP_TRANSPORT=stdio

# Optional: persistent file storage for uploaded notes (Supabase Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=notes

# Upload limits
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------
# Frontend (copy to frontend/.env)
# ---------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
