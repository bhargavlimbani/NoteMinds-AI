// StudyMCP AI - database schema (PostgreSQL + Prisma ORM)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Users
// ---------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // bcrypt hash, never plain text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects      Subject[]
  notes         Note[]
  progress      Progress[]
  quizzes       Quiz[]
  quizResults   QuizResult[]
  conversations Conversation[]
  activities    Activity[]
}

// ---------------------------------------------------------------
// Academic structure: Subject -> Unit -> Topic
// ---------------------------------------------------------------

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String?
  description String?
  color       String   @default("violet")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  units   Unit[]
  notes   Note[]
  quizzes Quiz[]

  @@index([userId])
}

model Unit {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int      @default(0)
  subjectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject  Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics   Topic[]
  notes    Note[]
  progress Progress[]
  quizzes  Quiz[]

  @@index([subjectId])
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  completed Boolean  @default(false)
  order     Int      @default(0)
  unitId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
}

// ---------------------------------------------------------------
// Notes (uploaded PDF / TXT, text extracted and chunked for search)
// ---------------------------------------------------------------

model Note {
  id        String   @id @default(cuid())
  title     String
  fileName  String
  fileType  String // "pdf" | "txt"
  fileSize  Int
  fileUrl   String? // optional persistent storage URL (Supabase Storage)
  content   String   @db.Text
  wordCount Int      @default(0)
  userId    String
  subjectId String
  unitId    String?
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit    Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  chunks  NoteChunk[]

  @@index([userId])
  @@index([subjectId])
  @@index([unitId])
}

model NoteChunk {
  id      String @id @default(cuid())
  noteId  String
  index   Int
  content String @db.Text

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

// ---------------------------------------------------------------
// Progress (one row per user + unit)
// ---------------------------------------------------------------

model Progress {
  id            String   @id @default(cuid())
  userId        String
  unitId        String
  completion    Int      @default(0) // 0 - 100
  lastStudiedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
}

// ---------------------------------------------------------------
// Quizzes
// ---------------------------------------------------------------

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
  TRUE_FALSE
}

model Quiz {
  id                String     @id @default(cuid())
  title             String
  difficulty        Difficulty @default(MEDIUM)
  numberOfQuestions Int
  userId            String
  subjectId         String
  unitId            String?
  createdAt         DateTime   @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit      Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  results   QuizResult[]

  @@index([userId])
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  order         Int
  type          QuestionType @default(MCQ)
  question      String       @db.Text
  options       String[]
  correctAnswer String
  explanation   String?      @db.Text

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizResult {
  id           String   @id @default(cuid())
  quizId       String
  userId       String
  score        Int
  total        Int
  percentage   Float
  answers      Json // [{ questionId, selected, correct, isCorrect }]
  timeTakenSec Int?
  createdAt    DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

// ---------------------------------------------------------------
// AI chat history
// ---------------------------------------------------------------

enum MessageRole {
  USER
  ASSISTANT
}

model Conversation {
  id        String   @id @default(cuid())
  title     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  toolCalls      Json? // MCP tools used to produce an assistant message
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------------------------------------------------------------
// Study activity feed ("recently studied")
// ---------------------------------------------------------------

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String // NOTE_UPLOAD | QUIZ_COMPLETED | PROGRESS_UPDATED | TOPIC_COMPLETED | CHAT
  title     String
  subjectId String?
  unitId    String?
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
